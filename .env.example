# Required AWS S3 configuration
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
AWS_S3_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_PATH_STYLE_ACCESS_ENABLED=false
AWS_S3_PRESIGNED_URL_DURATION_MINUTES=15

# Required Gemini configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192
PERFORMANCE_WEB_SEARCH_ENABLED=false

# Optional Gemini API override
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local immutable event ledger
LEDGER_POSTGRES_DB=ratto_ledger
LEDGER_POSTGRES_USER=ledger
LEDGER_POSTGRES_PASSWORD=ledger

# Local Keycloak and core-service databases
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me
KEYCLOAK_POSTGRES_DB=keycloak
KEYCLOAK_POSTGRES_USER=keycloak
KEYCLOAK_POSTGRES_PASSWORD=change-me
CORE_POSTGRES_DB=ratto_core
CORE_POSTGRES_USER=core
CORE_POSTGRES_PASSWORD=change-me

# Public runtime OIDC configuration (no client secret; PKCE public client)
KEYCLOAK_PUBLIC_URL=http://localhost:3000
KEYCLOAK_REALM=ratto
KEYCLOAK_CLIENT_ID=ratto-frontend

# Social login. Enable only after providing credentials from the provider console.
# Google authorized redirect URI:
# http://localhost:3000/realms/ratto/broker/google/endpoint
SSO_GOOGLE_ENABLED=false
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Future Microsoft Entra ID / Azure SSO:
# http://localhost:3000/realms/ratto/broker/azure/endpoint
SSO_AZURE_ENABLED=false
AZURE_CLIENT_ID=YOUR_AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=YOUR_AZURE_CLIENT_SECRET
AZURE_TENANT_ID=YOUR_AZURE_TENANT_ID

# Gateway single public edge and configurable internal upstreams
GATEWAY_PUBLIC_URL=http://localhost:3000
GATEWAY_ROUTES_FRONTEND_URL=http://frontend:3000
GATEWAY_ROUTES_KEYCLOAK_URL=http://keycloak:8080
GATEWAY_ROUTES_CORE_URL=http://core-service:8071
GATEWAY_ROUTES_PRODUCER_URL=http://producer:8070

# Local observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
