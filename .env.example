# Required AWS S3 configuration
AWS_S3_BUCKET=your-s3-bucket-name
AWS_S3_REGION=us-east-1
AWS_S3_ACCESS_KEY=YOUR_AWS_ACCESS_KEY_ID
AWS_S3_SECRET_KEY=YOUR_AWS_SECRET_ACCESS_KEY
AWS_S3_PATH_STYLE_ACCESS_ENABLED=false
AWS_S3_PRESIGNED_URL_DURATION_MINUTES=15

# Required Gemini configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
GEMINI_MAX_OUTPUT_TOKENS=8192

# Optional Gemini API override
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Local immutable event ledger
LEDGER_POSTGRES_DB=learn_ia_ledger
LEDGER_POSTGRES_USER=ledger
LEDGER_POSTGRES_PASSWORD=ledger
